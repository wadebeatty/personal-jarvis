{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "@netlify/functions"]
  },
  "include": ["netlify/functions/**/*.ts"],
  "exclude": ["netlify/functions/**/*.test.ts"]
}
