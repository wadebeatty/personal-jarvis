# ElevenLabs Conversational AI (server-only — never expose to the browser)
ELEVENLABS_API_KEY=your_xi_api_key_here
ELEVENLABS_AGENT_ID=agent_0901kzw48twfeq4ar7jn0f87dx94

# Shared secret ElevenLabs and the Toquer/Forge fulfill agent send as X-Jarvis-Secret.
# Bridge is ready when this is set. GOOGLE_* is not required on Netlify.
JARVIS_TOOL_SECRET=generate_a_long_random_string

# Optional overrides for local tests (production defaults: 18000 / 400)
# JARVIS_BRIDGE_TIMEOUT_MS=18000
# JARVIS_BRIDGE_POLL_MS=400

# Optional override when registering tools against a preview deploy
# JARVIS_TOOL_BASE_URL=https://personal-jarvis-813.netlify.app
