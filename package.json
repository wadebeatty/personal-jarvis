{
  "name": "personal-jarvis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Wade Beatty’s personal Jarvis voice webapp (ElevenLabs Conversational AI + Netlify)",
  "scripts": {
    "dev": "npx netlify-cli dev",
    "build": "echo 'Static HUD — no frontend build'",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "oauth:google": "node scripts/google-oauth-setup.mjs",
    "tools:schema": "node scripts/register-elevenlabs-tools.mjs",
    "tools:register": "node scripts/register-elevenlabs-tools.mjs"
  },
  "devDependencies": {
    "@netlify/functions": "^4.2.6",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.13"
  }
}
